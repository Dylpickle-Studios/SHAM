{
  "name": "simple-hosting-and-more",
  "version": "1.2.0",
  "description": "SHAM is a self-hosted deployment control plane for static sites, managed processes, OCI containers, Docker Compose applications, and reverse-proxied services.",
  "main": "src/bootstrap.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/bootstrap.js",
    "dev": "node --watch src/server.js",
    "runtime-agent": "node runtime-agent/index.js",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "eslint src bin runtime-agent scripts test public",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-syntax.js && npm run lint && npm run typecheck",
    "test": "node --test test/*.test.js",
    "test:integration": "SHAM_RUN_INTEGRATION=1 node --test --test-concurrency=1 test/integration/*.integration.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "security": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check && npm test && npm run security",
    "release:check": "npm run check && npm test && node scripts/release-check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "better-sqlite3": "13.0.1",
    "clean-css": "5.3.3",
    "express": "5.2.0",
    "html-minifier-terser": "7.2.0",
    "http-proxy": "1.18.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "terser": "5.44.0"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "keywords": [
    "self-hosted",
    "hosting",
    "deployment",
    "static-sites",
    "nodejs",
    "docker",
    "sqlite",
    "control-plane"
  ],
  "bin": {
    "sham": "bin/sham.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  }
}
