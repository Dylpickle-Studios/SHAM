# Dashboard listener
SHAM_HOST=127.0.0.1
SHAM_PORT=8080
# Canonical browser-facing dashboard origin. Set this behind a reverse proxy so passkeys, OIDC callbacks, cookies, and CSRF checks agree.
# SHAM_PUBLIC_ORIGIN=https://sham.example.com
# Direct/local installs only: generate and serve a self-signed HTTPS certificate.
# Set SHAM_HOST=0.0.0.0 (or a LAN IP), then trust data/dashboard-tls/cert.pem on devices that access SHAM.
SHAM_SELF_SIGNED_HTTPS=false
SHAM_OPENSSL_BIN=openssl
SHAM_TRUST_PROXY=loopback
# Explicit reverse-proxy peers allowed to supply CF-Connecting-IP/CF-IPCountry
# Do not trust broad private ranges unless direct origin access is blocked.
SHAM_TRUSTED_EDGE_PROXIES=

# Persistent data; Docker defaults to /data
SHAM_DATA_PATH=./data

# Upload/editor limits
SHAM_UPLOAD_LIMIT_MB=100
SHAM_EDITOR_LIMIT_MB=2
SHAM_UPLOAD_WORKERS=2
SHAM_UPLOAD_QUEUE_LIMIT=16

# Legacy Node/dependency and request timeouts
SHAM_NODE_START_TIMEOUT_SECONDS=30
SHAM_NPM_INSTALL_TIMEOUT_SECONDS=600
SHAM_NPM_INSTALL_WORKERS=2
SHAM_NPM_INSTALL_QUEUE_LIMIT=32
SHAM_REQUEST_TIMEOUT_SECONDS=300

# Runtime performance bounds
SHAM_STATS_FLUSH_SECONDS=2
SHAM_MINIFY_MAX_MB=5
SHAM_MINIFY_CACHE_MB=32
SHAM_MINIFY_WORKERS=2
SHAM_MINIFY_QUEUE_LIMIT=64
SHAM_COMPRESSION_WORKERS=4
SHAM_COMPRESSION_QUEUE_LIMIT=128
SHAM_INTEGRATION_TIMEOUT_SECONDS=20
SHAM_VISITOR_RETENTION_DAYS=90
SHAM_VISITOR_PENDING_BUCKETS=50000
SHAM_AUTH_RATE_LIMIT_BUCKETS=10000
SHAM_FIREWALL_RATE_LIMIT_BUCKETS=50000

# Authentication and production cookies
SHAM_JWT_SECRET=replace-with-at-least-32-random-characters
# One-time token for creating the first administrator. When unset, SHAM
# generates one and prints it in the server log on first start.
# SHAM_SETUP_TOKEN=replace-with-at-least-16-random-characters
NODE_ENV=development

# Optional integration executables
SHAM_CERTBOT_BIN=certbot
SHAM_CLOUDFLARED_BIN=cloudflared

# Secret encryption and security services
# Prefer a Docker/Kubernetes secret in production. When omitted, SHAM stores a generated keyring under SHAM_DATA_PATH.
# SHAM_MASTER_KEY=base64-encoded-32-byte-key
SHAM_PERFORMANCE_INTERVAL_SECONDS=5
SHAM_PERFORMANCE_HISTORY_SAMPLES=720
SHAM_PERFORMANCE_SITE_CONCURRENCY=8
SHAM_DEPENDENCY_SCAN_TIMEOUT_SECONDS=120
SHAM_DEPENDENCY_SCAN_WORKERS=1
SHAM_DEPENDENCY_SCAN_QUEUE_LIMIT=16
SHAM_SNAPSHOT_RETENTION=10
SHAM_SNAPSHOT_WORKERS=1
SHAM_SNAPSHOT_QUEUE_LIMIT=8
SHAM_PLUGIN_ACTION_TIMEOUT_SECONDS=15
SHAM_PLUGIN_MAX_PENDING_ACTIONS=32

# Optional shared edge listener. Set to 80/443 in Docker when SHAM should route domains itself.
SHAM_EDGE_HOST=0.0.0.0
SHAM_EDGE_HTTP_PORT=0
SHAM_EDGE_HTTPS_PORT=0


# Safe deployments, automation, backups, and optional Anubis protection
SHAM_DOCKER_BIN=docker
# Optional source-to-image builders used by container runtime presets.
SHAM_PACK_BIN=pack
SHAM_NIXPACKS_BIN=nixpacks
# Shared networks used by Docker-isolated sites when SHAM itself runs in Docker.
SHAM_DOCKER_INTERNAL_NETWORK=sham-runtime-internal
SHAM_DOCKER_EGRESS_NETWORK=sham-runtime-egress
SHAM_GIT_BIN=git
SHAM_TAR_BIN=tar
SHAM_RESTIC_BIN=restic
SHAM_AWS_BIN=aws
SHAM_SFTP_BIN=sftp
# Stable Anubis image pinned by default; update only after policy compatibility testing.
SHAM_ANUBIS_IMAGE=ghcr.io/techarohq/anubis:v1.26.2
# Required only when SHAM runs in Docker and launches isolated site/Anubis containers.
# Must be the absolute host path that is mounted as SHAM_DATA_PATH inside SHAM.
# SHAM_DOCKER_HOST_DATA_PATH=/srv/sham/sham-data
SHAM_HEALTH_CHECK_CONCURRENCY=8
SHAM_JOB_POLL_SECONDS=15
SHAM_JOB_TIMEOUT_SECONDS=900
SHAM_BACKUP_TIMEOUT_SECONDS=3600
SHAM_GIT_TIMEOUT_SECONDS=600
SHAM_PREVIEW_TTL_HOURS=24
