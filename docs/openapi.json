{
  "openapi": "3.1.0",
  "info": {
    "title": "SHAM Public API",
    "version": "1.2.0",
    "description": "The stable, versioned SHAM automation API. Legacy /api routes remain compatibility aliases; new clients should use /api/v1. See docs/api-compatibility.md for support and deprecation policy."
  },
  "servers": [{ "url": "/api/v1", "description": "Current SHAM instance" }],
  "tags": [{ "name": "System" }, { "name": "Authentication" }, { "name": "Sites" }, { "name": "Deployments" }, { "name": "Operations" }, { "name": "Backups" }],
  "paths": {
    "/health": { "get": { "tags": ["System"], "summary": "Health check", "responses": { "200": { "description": "Healthy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } } },
    "/bootstrap": { "get": { "tags": ["Authentication"], "summary": "Read first-run and session state", "responses": { "200": { "description": "Bootstrap state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bootstrap" } } } } } } },
    "/auth/login": { "post": { "tags": ["Authentication"], "summary": "Create a browser session", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } }, "responses": { "200": { "description": "Authenticated" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/me": { "get": { "tags": ["Authentication"], "summary": "Current authenticated user", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "User" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/security/api-tokens": { "post": { "tags": ["Authentication"], "summary": "Create an API token", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "201": { "description": "Token created" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/sites": { "get": { "tags": ["Sites"], "summary": "List sites", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Sites", "content": { "application/json": { "schema": { "type": "object", "required": ["sites"], "properties": { "sites": { "type": "array", "items": { "$ref": "#/components/schemas/Site" } } } } } } }, "401": { "$ref": "#/components/responses/Error" } } }, "post": { "tags": ["Sites"], "summary": "Create a site", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SiteInput" } }, "multipart/form-data": { "schema": { "$ref": "#/components/schemas/SiteInput" } } } }, "responses": { "201": { "description": "Site created" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/sites/{siteId}": { "parameters": [{ "$ref": "#/components/parameters/SiteId" }], "get": { "tags": ["Sites"], "summary": "Get site details", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Site", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Site" } } } }, "404": { "$ref": "#/components/responses/Error" } } }, "put": { "tags": ["Sites"], "summary": "Update site configuration", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SiteInput" } } } }, "responses": { "200": { "description": "Updated" }, "400": { "$ref": "#/components/responses/Error" } } }, "delete": { "tags": ["Sites"], "summary": "Delete a site and SHAM-managed resources", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "204": { "description": "Deleted" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/sites/{siteId}/deploy/git": { "post": { "tags": ["Deployments"], "summary": "Deploy the configured Git source", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/SiteId" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "branch": { "type": "string" } } } } } }, "responses": { "200": { "description": "Deployment activated" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/sites/{siteId}/deployments": { "get": { "tags": ["Deployments"], "summary": "List deployment and release history", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/SiteId" }], "responses": { "200": { "description": "Deployment history" } } } },
    "/sites/{siteId}/releases/{releaseId}/rollback": { "post": { "tags": ["Deployments"], "summary": "Atomically roll back to a retained release", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/SiteId" }, { "$ref": "#/components/parameters/ReleaseId" }], "responses": { "200": { "description": "Release activated" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/sites/{siteId}/start": { "post": { "tags": ["Operations"], "summary": "Start site runtime", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/SiteId" }], "responses": { "200": { "description": "Started" } } } },
    "/sites/{siteId}/stop": { "post": { "tags": ["Operations"], "summary": "Stop site runtime", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/SiteId" }], "responses": { "200": { "description": "Stopped" } } } },
    "/sites/{siteId}/restart": { "post": { "tags": ["Operations"], "summary": "Restart site runtime", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/SiteId" }], "responses": { "200": { "description": "Restarted" } } } },
    "/runtime-logs": { "get": { "tags": ["Operations"], "summary": "Read runtime logs", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "name": "siteId", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "Runtime logs" } } } },
    "/performance": { "get": { "tags": ["Operations"], "summary": "Read performance telemetry", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Performance telemetry" } } } },
    "/admin/pangolin-tunnel": { "put": { "tags": ["Operations"], "summary": "Configure the supervised Pangolin Newt connector", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PangolinTunnelInput" } } } }, "responses": { "200": { "description": "Connector configuration and runtime state" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/admin/pangolin-tunnel/restart": { "post": { "tags": ["Operations"], "summary": "Restart the supervised Pangolin Newt connector", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Connector runtime state" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/admin/backups/run": { "post": { "tags": ["Backups"], "summary": "Create a verified backup", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Backup metadata" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/admin/backups/{backupId}/restore": { "post": { "tags": ["Backups"], "summary": "Stage a full backup restore for restart", "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "parameters": [{ "name": "backupId", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string", "format": "password" } } } } } }, "responses": { "200": { "description": "Restore staged" }, "400": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "SHAM API token" }, "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "sham_session" } },
    "parameters": { "SiteId": { "name": "siteId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }, "ReleaseId": { "name": "releaseId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } } },
    "responses": { "Error": { "description": "Structured API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } },
    "schemas": {
      "Health": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean", "const": true } } },
      "Bootstrap": { "type": "object", "required": ["needsSetup", "registrationEnabled", "authenticated"], "properties": { "needsSetup": { "type": "boolean" }, "registrationEnabled": { "type": "boolean" }, "authenticated": { "type": "boolean" } } },
      "LoginRequest": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password" } } },
      "SiteInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "domain": { "type": "string" }, "runtimeType": { "type": "string", "enum": ["static", "node", "process", "container", "compose", "proxy"] }, "source": { "type": "string", "enum": ["upload", "git", "image", "proxy"] }, "gitUrl": { "type": "string" }, "gitBranch": { "type": "string" }, "runtimePortEnv": { "type": "string", "default": "PORT" }, "additionalListeners": { "type": "array", "maxItems": 4, "description": "Private Node/process HTTP listeners. Not shared-edge or Cloudflare Tunnel origins.", "items": { "$ref": "#/components/schemas/PrivateListener" } }, "enabled": { "type": "boolean" } } },
      "PrivateListener": { "type": "object", "additionalProperties": false, "required": ["name", "port", "bindHost", "portEnv"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "bindHost": { "type": "string", "description": "Loopback, RFC1918/CGNAT IPv4, or ULA IPv6 address." }, "portEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" } } },
      "PangolinTunnelInput": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "endpoint": { "type": "string", "format": "uri", "description": "Pangolin dashboard endpoint; HTTPS is required except for loopback testing." }, "newtId": { "type": "string" }, "secret": { "type": "string", "format": "password", "writeOnly": true }, "clearSecret": { "type": "boolean", "default": false } } },
      "Site": { "allOf": [{ "$ref": "#/components/schemas/SiteInput" }, { "type": "object", "required": ["id", "slug"], "properties": { "id": { "type": "integer" }, "slug": { "type": "string" }, "runtime": { "type": "object" } } }] },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "example": "SITE_NOT_FOUND" }, "message": { "type": "string", "example": "Site not found" } } } } }
    }
  }
}
